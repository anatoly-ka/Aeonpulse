<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Aeonpulse.Views.SettingsPopup"
             x:Name="SettingsPopupPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <!-- AI: Full-screen overlay grid.
             Layer 0 (z=0): transparent BoxView captures taps outside the panel to dismiss.
             Layer 1 (z=1): centered Frame is the actual settings panel. -->
        <Grid x:Name="OverlayGrid"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- Tap-to-dismiss backdrop - covers full screen, triggers close on tap -->
            <BoxView x:Name="DismissBackdrop"
                     Color="Transparent"
                     InputTransparent="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- AI: Centered modal panel - floats over the backdrop.
                 BorderColor and BackgroundColor use DynamicResource for live theme support. -->
            <Frame x:Name="SettingsPanel"
                   BackgroundColor="{DynamicResource CardBackground}"
                   CornerRadius="16"
                   Padding="0"
                   HasShadow="True"
                   BorderColor="{DynamicResource CyberPurple}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="24,0"
                   MinimumWidthRequest="300">

                <!-- AI: 3-row panel layout: [Row0: Title+Divider | Row1: Scrollable Settings | Row2: Close Button footer] -->
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Row 0: Title bar -->
                    <VerticalStackLayout Grid.Row="0"
                                         x:Name="SettingsTitleBar"
                                         Spacing="0"
                                         Padding="24,20,24,0">
                        <!-- Binding: MainViewModel.Loc.Settings_Title (live-localised via LocalizedResources) -->
                        <Label x:Name="SettingsTitleLabel"
                               Text=""
                               FontSize="{StaticResource FontSizeTitle}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource CyberCyan}" />

                        <BoxView x:Name="TitleDivider"
                                 HeightRequest="1"
                                 Color="{DynamicResource CyberPurple}"
                                 Opacity="0.4"
                                 HorizontalOptions="Fill"
                                 Margin="0,16,0,0" />
                    </VerticalStackLayout>

                    <!-- Row 1: Scrollable settings content area -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout x:Name="SettingsContentArea"
                                             Spacing="16"
                                             Padding="24,16">

                        <!-- "Settings" sub-section header -->
                        <!-- Binding: MainViewModel.Loc.Settings_SettingsTitle (live-localised) -->
                        <Label x:Name="SettingsSectionHeader"
                               Text=""
                               FontSize="{DynamicResource FontSizeMedium}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource CyberPurple}" />

                        <!-- AI: 2-column, 14-row settings control grid.
                             Col 0 (Auto): group label - each spans multiple rows for vertical centering.
                             Col 1 (*):    option rows, one option per row.
                             Row groups:
                               Rows 0-1:   Unit System  (Metric / Imperial)
                               Row  2:     spacer
                               Rows 3-5:   Color Scheme (DefaultDark / HighContrastDark / HighContrastLight)
                               Row  6:     spacer
                               Rows 7-9:   Text Size    (Small / Normal / Large)
                               Row  10:    spacer
                               Rows 11-13: Language     (Default / English / Russian)
                             Each option row is a HorizontalStackLayout with two Ellipses (outer ring +
                             inner dot) and a Label, wired via TapGestureRecognizer. No RadioButton is
                             used — avoids WinUI RadioButton handler layout interference on Windows. -->
                        <Grid x:Name="SettingsControlGrid"
                              ColumnDefinitions="100,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="16"
                              RowSpacing="8">

                            <!-- == UNIT SYSTEM ======================================= -->

                            <!-- Binding: MainViewModel.Loc.Settings_UnitsLabel (live-localised) -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Grid.RowSpan="2"
                                   x:Name="UnitsLabel"
                                   Text=""
                                   FontSize="{DynamicResource FontSizeMedium}"
                                   TextColor="{DynamicResource TextGray}"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />

                            <!-- Row 0, Col 1: Metric -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitSystemTapped" CommandParameter="Metric" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="MetricDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_UnitsMetric (live-localised) -->
                                <Label x:Name="MetricLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 1, Col 1: Imperial -->
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitSystemTapped" CommandParameter="Imperial" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="ImperialDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_UnitsImperial (live-localised) -->
                                <Label x:Name="ImperialLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 2: visual spacer -->
                            <BoxView Grid.Row="2" Grid.ColumnSpan="2"
                                     HeightRequest="4" Color="Transparent" />

                            <!-- == COLOR SCHEME ====================================== -->

                            <!-- Binding: MainViewModel.Loc.Settings_PaletteLabel (live-localised) -->
                            <Label Grid.Row="3" Grid.Column="0"
                                   Grid.RowSpan="3"
                                   x:Name="PaletteLabel"
                                   Text=""
                                   FontSize="{DynamicResource FontSizeMedium}"
                                   TextColor="{DynamicResource TextGray}"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />

                            <!-- Row 3, Col 1: Default Dark -->
                            <HorizontalStackLayout Grid.Row="3" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnColorSchemeTapped" CommandParameter="DefaultDark" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="DefaultDarkDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_PaletteDefault (live-localised) -->
                                <Label x:Name="DefaultDarkLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 4, Col 1: High Contrast Dark -->
                            <HorizontalStackLayout Grid.Row="4" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnColorSchemeTapped" CommandParameter="HighContrastDark" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="HighContrastDarkDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_PaletteHighContrastDark (live-localised) -->
                                <Label x:Name="HighContrastDarkLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 5, Col 1: High Contrast Light -->
                            <HorizontalStackLayout Grid.Row="5" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnColorSchemeTapped" CommandParameter="HighContrastLight" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="HighContrastLightDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_PaletteHighContrastLight (live-localised) -->
                                <Label x:Name="HighContrastLightLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 6: visual spacer -->
                            <BoxView Grid.Row="6" Grid.ColumnSpan="2"
                                     HeightRequest="4" Color="Transparent" />

                            <!-- == TEXT SIZE ========================================= -->

                            <!-- Binding: MainViewModel.Loc.Settings_TextSizeLabel (live-localised) -->
                            <Label Grid.Row="7" Grid.Column="0"
                                   Grid.RowSpan="3"
                                   x:Name="TextSizeLabel"
                                   Text=""
                                   FontSize="{DynamicResource FontSizeMedium}"
                                   TextColor="{DynamicResource TextGray}"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />

                            <!-- Row 7, Col 1: Small -->
                            <HorizontalStackLayout Grid.Row="7" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextSizeTapped" CommandParameter="Small" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="TextSizeSmallDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_TextSizeSmall (live-localised) -->
                                <Label x:Name="TextSizeSmallLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 8, Col 1: Normal -->
                            <HorizontalStackLayout Grid.Row="8" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextSizeTapped" CommandParameter="Normal" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="TextSizeNormalDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_TextSizeNormal (live-localised) -->
                                <Label x:Name="TextSizeNormalLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 9, Col 1: Large -->
                            <HorizontalStackLayout Grid.Row="9" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextSizeTapped" CommandParameter="Large" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="TextSizeLargeDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_TextSizeLarge (live-localised) -->
                                <Label x:Name="TextSizeLargeLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 10: visual spacer -->
                            <BoxView Grid.Row="10" Grid.ColumnSpan="2"
                                     HeightRequest="4" Color="Transparent" />

                            <!-- == DISPLAY LANGUAGE ================================== -->

                            <!-- Binding: MainViewModel.Loc.Settings_LanguageLabel (live-localised) -->
                            <Label Grid.Row="11" Grid.Column="0"
                                   Grid.RowSpan="3"
                                   x:Name="LanguageLabel"
                                   Text=""
                                   FontSize="{DynamicResource FontSizeMedium}"
                                   TextColor="{DynamicResource TextGray}"
                                   LineBreakMode="WordWrap"
                                   VerticalOptions="Center" />

                            <!-- Row 11, Col 1: Default -->
                            <HorizontalStackLayout Grid.Row="11" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageTapped" CommandParameter="Default" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="LangDefaultDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_LanguageDefault (live-localised) -->
                                <Label x:Name="LangDefaultLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 12, Col 1: English -->
                            <HorizontalStackLayout Grid.Row="12" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageTapped" CommandParameter="English" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="LangEnglishDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_LanguageEnglish (live-localised) -->
                                <Label x:Name="LangEnglishLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Row 13, Col 1: Russian -->
                            <HorizontalStackLayout Grid.Row="13" Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLanguageTapped" CommandParameter="Russian" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Grid WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Ellipse WidthRequest="16" HeightRequest="16"
                                             Stroke="{DynamicResource CyberCyan}"
                                             StrokeThickness="2"
                                             Fill="Transparent" />
                                    <Ellipse x:Name="LangRussianDot"
                                             WidthRequest="8" HeightRequest="8"
                                             HorizontalOptions="Center" VerticalOptions="Center"
                                             Fill="{DynamicResource CyberCyan}"
                                             IsVisible="False" />
                                </Grid>
                                <!-- Binding: MainViewModel.Loc.Settings_LanguageRussian (live-localised) -->
                                <Label x:Name="LangRussianLabel"
                                       Text=""
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource CyberCyan}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                        </Grid>
                        <!-- End SettingsControlGrid -->

                        <!-- Reset Settings button - restores all settings to factory defaults -->
                        <Button x:Name="ResetSettingsButton"
                                Text=""
                                Clicked="OnResetSettingsTapped"
                                HorizontalOptions="Center"
                                WidthRequest="160"
                                BackgroundColor="{DynamicResource SpaceDark}"
                                TextColor="{DynamicResource TextGray}"
                                CornerRadius="8"
                                FontSize="{DynamicResource FontSizeMedium}"
                                HeightRequest="36"
                                BorderColor="{DynamicResource TextGray}"
                                BorderWidth="1" />

                        <!-- Divider between Settings and About sections -->
                        <BoxView x:Name="SettingsAboutDivider"
                                 HeightRequest="1"
                                 Color="{DynamicResource CyberPurple}"
                                 Opacity="0.4"
                                 HorizontalOptions="Fill" />

                        <!-- == ABOUT SECTION ========================================= -->
                        <!-- AI: Read-only informational section - version, description, tagline.
                             All strings are live-localised via Loc bindings. -->

                        <!-- Binding: MainViewModel.Loc.Settings_AboutTitle (live-localised) -->
                        <Label x:Name="AboutSectionHeader"
                               Text=""
                               FontSize="{StaticResource FontSizeMedium}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource CyberPurple}" />

                        <VerticalStackLayout x:Name="AboutContentStack" Spacing="6">
                            <!-- Binding: MainViewModel.Loc.Settings_AboutText (live-localised, HTML) -->
                            <Label x:Name="AboutTextLabel"
                                   Text=""
                                   TextType="Html"
                                   FontSize="{DynamicResource FontSizeMedium}"
                                   TextColor="{DynamicResource TextGray}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                    <!-- End SettingsContentArea -->
                    </ScrollView>

                    <!-- Row 2: Footer - fixed Close button below scrollable content -->
                    <VerticalStackLayout Grid.Row="2"
                                         x:Name="SettingsFooter"
                                         Padding="24,0,24,20"
                                         Spacing="0">
                        <BoxView x:Name="FooterDivider"
                                 HeightRequest="1"
                                 Color="{DynamicResource CyberPurple}"
                                 Opacity="0.4"
                                 HorizontalOptions="Fill"
                                 Margin="0,0,0,16" />
                        <!-- Binding: MainViewModel.Loc.Settings_ButtonClose (live-localised) -->
                        <Button x:Name="CloseButton"
                                Text=""
                                Clicked="OnCloseClicked"
                                HorizontalOptions="Center"
                                WidthRequest="160"
                                BackgroundColor="{DynamicResource SpaceDark}"
                                TextColor="{DynamicResource TextGray}"
                                CornerRadius="8"
                                FontSize="{DynamicResource FontSizeLarge}"
                                HeightRequest="44"
                                BorderColor="{DynamicResource CyberPurple}"
                                BorderWidth="1" />
                    </VerticalStackLayout>

                </Grid>
            </Frame>
        </Grid>
    </ContentPage.Content>
</ContentPage>