<?xml version="1.0" encoding="utf-8" ?>
<!-- AI: Tease popup - shown when the user taps the app logo or app name in the NavBar.
     Displays a single live stat (TeaseText) captured from MainViewModel.TeaseText
     at the moment of opening. Pushed modally from MainPage.OnLogoTapped().
     The Frame's top/left Margin is injected in code-behind to position the panel
     flush below the NavBar bottom edge, left-aligned. Width is auto (no fixed request)
     so the panel expands to fit its content without wrapping lines.
     Dismissed by "Close" button or "To Clipboard" button (which also copies text
     and shows a confirmation DisplayAlert). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:Aeonpulse.Resources"
             x:Class="Aeonpulse.Views.TeasePopup"
             x:Name="TeasePopupPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <!-- AI: Full-screen overlay grid.
             Layer 0: transparent BoxView captures taps outside the panel -> dismiss.
             Layer 1: the panel Frame, positioned by code-behind via Margin injection. -->
        <Grid x:Name="TeaseOverlay"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- Tap-to-dismiss backdrop -->
            <BoxView x:Name="DismissBackdrop"
                     Color="Transparent"
                     InputTransparent="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOkClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- AI: Panel frame - HorizontalOptions=Start + left Margin (set in code-behind)
                 aligns the panel to the left edge of the page below the NavBar.
                 No WidthRequest so the panel sizes to fit its content (no line-wrap). -->
            <Frame x:Name="TeasePanel"
                   BackgroundColor="{DynamicResource CardBackground}"
                   CornerRadius="16"
                   Padding="0"
                   HasShadow="True"
                   BorderColor="{DynamicResource CyberPurple}"
                   HorizontalOptions="Start"
                   VerticalOptions="Start">

                <!-- AI: 3-row panel: [Title+Divider | TeaseText | Footer with 2 buttons] -->
                <VerticalStackLayout Spacing="0">

                    <!-- Row 0: Title bar -->
                    <VerticalStackLayout x:Name="TeaseTitleBar"
                                         Spacing="0"
                                         Padding="24,20,24,0">
                        <Label x:Name="TeaseTitleLabel"
                               Text="{x:Static resources:AppResources.Tease_Title}"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource CyberCyan}" />

                        <BoxView x:Name="TeaseDivider"
                                 HeightRequest="1"
                                 Color="{DynamicResource CyberPurple}"
                                 Opacity="0.4"
                                 HorizontalOptions="Fill"
                                 Margin="0,16,0,0" />
                    </VerticalStackLayout>

                    <!-- Row 1: Content - tease stat text, no line-wrap by design -->
                    <!-- x:Name required: code-behind sets TeaseTextLabel.Text from constructor arg -->
                    <Label x:Name="TeaseTextLabel"
                           FontSize="{DynamicResource FontSizeLarge}"
                           HorizontalOptions="Start"
                           HorizontalTextAlignment="Start"
                           TextColor="{DynamicResource TextWhite}"
                           Padding="24,16" />

                    <!-- Row 2: Footer divider + 2-button row -->
                    <VerticalStackLayout Spacing="0">
                        <BoxView HeightRequest="1"
                                 Color="{DynamicResource CyberPurple}"
                                 Opacity="0.4"
                                 HorizontalOptions="Fill" />

                        <!-- AI: Right-aligned button pair, both sized to content.
                             HorizontalOptions=End keeps the group flush to the right edge.
                             No ColumnDefinitions stretch - each button sizes to its own text.
                             MinimumWidthRequest="140" ensures "To Clipboard" fits at FontSize=Large.
                             TextColor and BorderColor override CyberButton's StaticResource
                             so they match the content text (TextWhite) and respond to theme changes.
                             FontSize uses DynamicResource so FontSizeService presets apply. -->
                        <HorizontalStackLayout x:Name="TeaseButtonRow"
                                               HorizontalOptions="End"
                                               Spacing="12"
                                               Padding="16,12">

                            <!-- Left of pair: Copy to clipboard + close -->
                            <Button x:Name="TeaseCopyButton"
                                    Text="{x:Static resources:AppResources.Tease_ButtonCopy}"
                                    Style="{StaticResource CyberButton}"
                                    TextColor="{DynamicResource TextWhite}"
                                    BorderColor="{DynamicResource TextWhite}"
                                    FontSize="{DynamicResource FontSizeLarge}"
                                    MinimumWidthRequest="140"
                                    Clicked="OnCopyClicked" />

                            <!-- Right of pair: Close popup -->
                            <Button x:Name="TeaseOkButton"
                                    Text="{x:Static resources:AppResources.Tease_ButtonOK}"
                                    Style="{StaticResource CyberButton}"
                                    TextColor="{DynamicResource TextWhite}"
                                    BorderColor="{DynamicResource TextWhite}"
                                    FontSize="{DynamicResource FontSizeLarge}"
                                    MinimumWidthRequest="140"
                                    Clicked="OnOkClicked" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ContentPage.Content>
</ContentPage>
