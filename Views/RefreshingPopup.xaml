<?xml version="1.0" encoding="utf-8" ?>
<!-- AI: Transient loading overlay shown during a manual ticker refresh.
     Pushed modally by MainPage.OnTickerRefreshRequested(), auto-dismissed
     after 3 seconds via RefreshingPopup.xaml.cs OnAppearing().
     No BindingContext - all content is static. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:Aeonpulse.Resources"
             x:Class="Aeonpulse.Views.RefreshingPopup"
             x:Name="RefreshingPopupPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <!-- AI: Centred card layout - no dismiss gesture; auto-dismissed after 3 s -->
        <Grid x:Name="RefreshingRoot"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              Margin="24,0">

            <Frame x:Name="RefreshingPanel"
                   BackgroundColor="{DynamicResource CardBackground}"
                   CornerRadius="16"
                   Padding="32"
                   HasShadow="True"
                   BorderColor="{DynamicResource CyberPurple}">

                <VerticalStackLayout x:Name="RefreshingContent"
                                     Spacing="16"
                                     HorizontalOptions="Center">

                    <!-- Animated spinner - IsRunning=True keeps it animating for the full 3 s -->
                    <ActivityIndicator x:Name="RefreshingSpinner"
                                       IsRunning="True"
                                       Color="{DynamicResource CyberCyan}"
                                       WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center" />

                    <!-- Binding: x:Static AppResources.Refreshing_Message (static, not live-localised) -->
                    <Label x:Name="RefreshingMessageLabel"
                           Text="{x:Static resources:AppResources.Refreshing_Message}"
                           FontSize="{DynamicResource FontSizeXLarge}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource CyberCyan}" />

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ContentPage.Content>
</ContentPage>