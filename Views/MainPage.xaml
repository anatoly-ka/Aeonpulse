<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Aeonpulse.ViewModels"
             xmlns:converters="clr-namespace:Aeonpulse.Converters"
             xmlns:helpers="clr-namespace:Aeonpulse.Helpers"
             x:Class="Aeonpulse.Views.MainPage"
             x:Name="MainPageRoot"
             BackgroundColor="{DynamicResource SpaceDarker}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Converts bool IsExpanded -> Visibility for collapsible sections -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- Inverts bool for collapsed-state indicators (e.g., chevron direction) -->
            <converters:InverseBoolConverter x:Key="InverseBool" />
            <!-- Converts bool IsExpanded -> image source for expand/collapse icons -->
            <converters:BoolToImageSourceConverter x:Key="BoolToImageSource" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- AI: BindingContext = MainViewModel (constructed inline by XAML).
         MainPage.xaml.cs also accesses this VM instance via BindingContext cast
         to wire the RefreshRequested event. -->
    <ContentPage.BindingContext>
        <viewmodels:MainViewModel />
    </ContentPage.BindingContext>

    <!-- AI: Root 3-row grid: [NavBar | TimelineHeading | ScrollContent].
         MinimumWidthRequest/MinimumHeightRequest enforce the baseline phone viewport. -->
    <Grid RowDefinitions="Auto,Auto,*"
          MinimumWidthRequest="393"
          MinimumHeightRequest="852">

        <!-- AI: Row 0 - Top Navigation Bar.
             3-column layout: [Logo+AppName | spacer | HamburgerMenu].
             BackgroundColor uses DynamicResource so ThemeService swaps are instant. -->
        <Border Grid.Row="0"
                x:Name="NavBar"
                BackgroundColor="{DynamicResource SpaceDark}"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left Section: tinted logo image + app name label -->
                <HorizontalStackLayout Grid.Column="0"
                                       x:Name="NavBarLogoSection"
                                       Spacing="12">

                    <!-- Logo image - pixel-level tint applied via ImageTint attached property
                         using platform handler mappers (see MauiProgram.cs) -->
                    <Image x:Name="LogoImage"
                           Source="aeonpulse.png"
                           Style="{StaticResource ThemedLogoImage}"
                           helpers:ImageTint.Color="{DynamicResource CyberCyan}" />

                    <!-- Binding: Loc.AppName -> MainViewModel.Loc (LocalizedResources singleton).
                         Tap opens the TeasePopup (see OnLogoTapped in code-behind). -->
                    <Label x:Name="AppNameLabel"
                           Text="{Binding Loc.AppName}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource CyberCyan}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <!-- Hamburger menu button - opens MainMenuPopup modal page -->
                <Button Grid.Column="2"
                        x:Name="MenuButton"
                        Text="☰"
                        FontSize="{DynamicResource FontSizeTitle}"
                        TextColor="{DynamicResource CyberCyan}"
                        BackgroundColor="Transparent"
                        WidthRequest="48"
                        HeightRequest="48"
                        Clicked="OnMenuClicked" />
            </Grid>
        </Border>

        <!-- AI: Row 1 - Timeline Heading.
             Displays "{BaseDateName} from {BaseDateDisplay}" as a tappable row
             that opens the ChangeDatePopup for quick base-date editing.
             Binding sources: MainViewModel.BaseDateName, Loc.Timeline_BaseDatePreposition,
             MainViewModel.BaseDateDisplay. -->
        <Border Grid.Row="1"
                x:Name="TimelineHeading"
                Padding="16,12"
                BackgroundColor="{DynamicResource SpaceDarker}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTimelineHeadingTapped" />
                </HorizontalStackLayout.GestureRecognizers>

                <!-- AI: Inline FormattedString composed of 5 spans:
                     [BaseDateName (bold+white)] [space] [preposition (localised)] [space] [BaseDateDisplay (bold+white)] [:]
                     Using FormattedText instead of multiple Labels avoids unwanted spacing/wrapping. -->
                <Label x:Name="TimelineHeadingLabel"
                       FontSize="{DynamicResource FontSizeTitle}"
                       TextColor="{DynamicResource TextDim}"
                       Opacity="0.9"
                       VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <!-- Binding: MainViewModel.BaseDateName (user-entered event label) -->
                            <Span Text="{Binding BaseDateName}"
                                  FontAttributes="Bold"
                                  TextColor="{DynamicResource TextWhite}" />
                            <Span Text=" " />
                            <!-- Binding: MainViewModel.Loc.Timeline_BaseDatePreposition (live-localised) -->
                            <Span Text="{Binding Loc.Timeline_BaseDatePreposition}" />
                            <Span Text=" " />
                            <!-- Binding: MainViewModel.BaseDateDisplay (culture-aware short date string) -->
                            <Span Text="{Binding BaseDateDisplay}"
                                  FontAttributes="Bold"
                                  TextColor="{DynamicResource TextWhite}" />
                            <Span Text=":" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>
        </Border>

        <!-- AI: Row 2 - Main Content.
             VerticalScrollView containing:
             Timeline "ticker" sections (inspired by Instagram/Facebook story timelines).
             Each section is a Card (Border) containing:
             - Header: title + commands (refresh, info, toggle)
             - Content: brief summary + expanded details (collapsible)
             Section data is an ObservableCollection<TickerItem> in MainViewModel. -->
        <ScrollView Grid.Row="2" Padding="16">
            <VerticalStackLayout Spacing="16">

                <!-- == LAB SECTION ============================================
                     Tickers: Time Jubilees, Countdown (LIVE), Life Odometer (LIVE), Cellular Refresh
                     Binding: MainViewModel.LabExpanded -> ToggleLabCommand
                ================================================================ -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">

                        <!-- AI: Section header row - [title label | expand/collapse icon button].
                             Source binding uses BoolToImageSource with "chevron_up|chevron_down" parameter. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Binding: MainViewModel.Loc.Section_LabTitle (live-localised) -->
                            <Label Grid.Column="0"
                                   Text="{Binding Loc.Section_LabTitle}"
                                   Style="{StaticResource SubtitleLabel}"
                                   TextColor="{DynamicResource CyberCyan}"
                                   VerticalOptions="Center" />
                            <!-- Binding: MainViewModel.LabExpanded -> BoolToImageSource -> chevron icon.
                                 Command: MainViewModel.ToggleLabCommand toggles LabExpanded. -->
                            <ImageButton Grid.Column="1"
                                         Style="{StaticResource ThemedIconButton}"
                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                         Source="{Binding LabExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='chevron_up.png|chevron_down.png'}"
                                         Command="{Binding ToggleLabCommand}" />
                        </Grid>

                        <!-- AI: Section body - visible only when LabExpanded=true.
                             Contains 4 ticker cards: Time Jubilees, Countdown, Life Odometer, Cellular Refresh. -->
                        <VerticalStackLayout Spacing="12"
                                             IsVisible="{Binding LabExpanded}">

                            <!-- == TICKER: TIME JUBILEES ===========================
                                 Static ticker (not live) - recalculated on base date change
                                 or via explicit RefreshTimeJubileesCommand.
                                 Binding: MainViewModel.TimeJubilees (TickerData)
                                 Commands: RefreshTimeJubileesCommand, ToggleTimeJubileesCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">

                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: emoji icon | Col1: title | Col2: action buttons (info, refresh, expand)] -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F4C5; -->
                                        <Label Grid.Column="0"
                                               Text="📅"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_TimeJubileesTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_TimeJubileesTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnTimeJubileesInfoClicked" />
                                            <!-- Refresh: shows RefreshingPopup then recalculates TimeJubilees -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="refresh.png"
                                                         Command="{Binding RefreshTimeJubileesCommand}" />
                                            <!-- Expand/collapse: toggles TimeJubileesExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding TimeJubileesExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleTimeJubileesCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Binding: MainViewModel.TimeJubilees.BriefText - hidden when expanded -->
                                    <Label Text="{Binding TimeJubilees.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding TimeJubileesExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.TimeJubilees.FullText - visible when expanded -->
                                    <Label Text="{Binding TimeJubilees.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding TimeJubileesExpanded}" />
                                    <!-- AI: Time Jubilees timeline graphic - visible only when TimeJubileesExpanded=true.
                                         Col 0: AbsoluteLayout with a 2 px vertical line + 3 proportional dots (Last, Today, Next).
                                         Col 1: 3-row Grid with milestone labels and days-context VerticalStackLayout.
                                         ProgressFraction [0.05,0.95] is clamped by the ViewModel so the Today dot
                                         never overlaps the endpoint dots. IsMoreRoomAtBottom drives label placement:
                                         true (ProgressFraction < 0.5) shows days info below Today; false shows it above.
                                         All colors use DynamicResource so ThemeService scheme swaps apply instantly.
                                         Binding sources: TimeJubilees.LastJubileeName, TimeJubilees.NextJubileeName,
                                         TimeJubilees.DaysSinceLast, TimeJubilees.DaysTillNext,
                                         TimeJubilees.IsMoreRoomAtBottom. -->
                                    <Grid Margin="10,20,10,10"
                                          HeightRequest="220"
                                          IsVisible="{Binding TimeJubileesExpanded}"
                                          ColumnDefinitions="40, *">

                                        <!-- Col 0: AbsoluteLayout containing 2 px vertical line + 3 proportional dots -->
                                        <AbsoluteLayout Grid.Column="0"
                                                        HorizontalOptions="Center"
                                                        WidthRequest="20">

                                            <!-- Vertical timeline line: 2 px wide (absolute), 90% of layout height.    -->
                                            <!-- XProportional, YProportional centre the line; HeightProportional spans  -->
                                            <!-- 90%. Width is NOT proportional so it stays at 2 device pixels.          -->
                                            <BoxView AbsoluteLayout.LayoutBounds="0.5, 0.5, 2, 0.9"
                                                     AbsoluteLayout.LayoutFlags="XProportional, YProportional, HeightProportional"
                                                     Color="{DynamicResource TextGray}" />

                                            <!-- Last Jubilee solid dot at top (5%) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="0.5, 0.05, 14, 14"
                                                     AbsoluteLayout.LayoutFlags="PositionProportional"
                                                     Fill="{DynamicResource TextWhite}" />

                                            <!-- Today gold ring dot - Y position set imperatively from ProgressFraction -->
                                            <!-- in MainPage.xaml.cs because AbsoluteLayout.LayoutBounds cannot bind.    -->
                                            <!-- the text column uses IsMoreRoomAtBottom to convey today's position.     -->
                                            <Ellipse x:Name="TodayDot"
                                                     AbsoluteLayout.LayoutBounds="0.5, 0.5, 14, 14"
                                                     AbsoluteLayout.LayoutFlags="PositionProportional"
                                                     Fill="Transparent"
                                                     Stroke="{DynamicResource JubileeAccent}"
                                                     StrokeThickness="3" />

                                            <!-- Next Jubilee solid dot at bottom (95%) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="0.5, 0.95, 14, 14"
                                                     AbsoluteLayout.LayoutFlags="PositionProportional"
                                                     Fill="{DynamicResource JubileeAccent}" />
                                        </AbsoluteLayout>

                                        <!-- Col 1: 3-row Grid for milestone labels and days-context text -->
                                        <Grid Grid.Column="1"
                                              RowDefinitions="Auto, *, Auto">

                                            <!-- Row 0: Last Jubilee label (top anchor) -->
                                            <!-- Binding: MainViewModel.TimeJubilees.LastJubileeName -->
                                            <Label Grid.Row="0"
                                                   Margin="15,5,0,0"
                                                   VerticalOptions="Start"
                                                   Text="{Binding TimeJubilees.LastJubileeName}"
                                                   FontAttributes="Bold"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource TextWhite}" />

                                            <!-- Row 1: Today context block - label order shifts via IsMoreRoomAtBottom -->
                                            <!-- Days-above/Today/Days-below pattern prevents overlap with endpoint dots. -->
                                            <VerticalStackLayout Grid.Row="1"
                                                                 Margin="15,0,0,0"
                                                                 VerticalOptions="Center"
                                                                 Spacing="4">

                                                <!-- Days context ABOVE Today - shown when ProgressFraction >= 0.5 -->
                                                <!-- Binding: IsMoreRoomAtBottom=false means Today is in the lower half -->
                                                <Label FontSize="{DynamicResource FontSizeSmall}"
                                                       TextColor="{DynamicResource TextGray}"
                                                       IsVisible="{Binding TimeJubilees.IsMoreRoomAtBottom, Converter={StaticResource InverseBool}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <!-- Binding: MainViewModel.TimeJubilees.DaysSinceLast -->
                                                            <Span Text="{Binding TimeJubilees.DaysSinceLast, StringFormat='{0:N0}'}" />
                                                            <Span Text="{Binding Loc.Ticker_TimeJubilees_DaysPassed}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label FontSize="{DynamicResource FontSizeSmall}"
                                                       TextColor="{DynamicResource TextGray}"
                                                       IsVisible="{Binding TimeJubilees.IsMoreRoomAtBottom, Converter={StaticResource InverseBool}}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <!-- Binding: MainViewModel.TimeJubilees.DaysTillNext -->
                                                            <Span Text="{Binding TimeJubilees.DaysTillNext, StringFormat='{0:N0}'}" />
                                                            <Span Text="{Binding Loc.Ticker_TimeJubilees_DaysLeft}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>

                                                <!-- Today label - always visible -->
                                                <!-- Binding: MainViewModel.Loc.Ticker_TimeJubilees_Today (live-localised) -->
                                                <Label Text="{Binding Loc.Ticker_TimeJubilees_Today}"
                                                       FontAttributes="Bold"
                                                       FontSize="{DynamicResource FontSizeSmall}"
                                                       TextColor="{DynamicResource JubileeAccent}" />

                                                <!-- Days context BELOW Today - shown when ProgressFraction < 0.5 -->
                                                <!-- Binding: IsMoreRoomAtBottom=true means Today is in the upper half -->
                                                <Label FontSize="{DynamicResource FontSizeSmall}"
                                                       TextColor="{DynamicResource TextGray}"
                                                       IsVisible="{Binding TimeJubilees.IsMoreRoomAtBottom}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <!-- Binding: MainViewModel.TimeJubilees.DaysSinceLast -->
                                                            <Span Text="{Binding TimeJubilees.DaysSinceLast, StringFormat='{0:N0}'}" />
                                                            <Span Text="{Binding Loc.Ticker_TimeJubilees_DaysPassed}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label FontSize="{DynamicResource FontSizeSmall}"
                                                       TextColor="{DynamicResource TextGray}"
                                                       IsVisible="{Binding TimeJubilees.IsMoreRoomAtBottom}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <!-- Binding: MainViewModel.TimeJubilees.DaysTillNext -->
                                                            <Span Text="{Binding TimeJubilees.DaysTillNext, StringFormat='{0:N0}'}" />
                                                            <Span Text="{Binding Loc.Ticker_TimeJubilees_DaysLeft}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                            <!-- Row 2: Next Jubilee label (bottom anchor) -->
                                            <!-- Binding: MainViewModel.TimeJubilees.NextJubileeName -->
                                            <Label Grid.Row="2"
                                                   Margin="15,0,0,5"
                                                   VerticalOptions="End"
                                                   Text="{Binding TimeJubilees.NextJubileeName}"
                                                   FontAttributes="Bold"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource JubileeAccent}" />
                                        </Grid>

                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: COUNTDOWN ==============================
                                 LIVE ticker - updated every second by MainViewModel timer.
                                 Binding: MainViewModel.Countdown (TickerData)
                                 Commands: ToggleCountdownCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x23F1;&#xFE0F; -->
                                        <Label Grid.Column="0"
                                               Text="⏱️"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- AI: Title + LIVE badge side-by-side in a HorizontalStackLayout.
                                             Badge Labels carry x:Name="LiveBadgeXxx" so MainPage.xaml.cs can
                                             drive a continuous InOutSine breathing animation via Animation.Commit. -->
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="8"
                                                               VerticalOptions="Center">
                                            <!-- Binding: MainViewModel.Loc.Ticker_CountdownTitle (live-localised) -->
                                            <Label Text="{Binding Loc.Ticker_CountdownTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised) -->
                                            <Label x:Name="LiveBadgeCountdown"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnCountdownInfoClicked" />
                                            <!-- Expand/collapse: toggles CountdownExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding CountdownExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleCountdownCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.Countdown.BriefText - hidden when expanded, updates every second -->
                                    <Label Text="{Binding Countdown.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding CountdownExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.Countdown.FullText - visible when expanded -->
                                    <Label Text="{Binding Countdown.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding CountdownExpanded}" />
                                    <!-- AI: Split-flap illustration for the expanded Countdown card.
                                         Source is a XAML literal ("anim_countdown.gif"), NOT a binding.
                                         Using a literal prevents MAUI's ImageHandler from restarting the
                                         GIF decoder every second when the Countdown live-ticker replaces
                                         its CountdownResult object (which would reset animation to frame 0).
                                         IsAnimationPlaying=True is respected by MAUI's built-in GIF decoder
                                         (ParseGIFBitmapHeaderAsync) on all platforms including Windows.
                                         IsVisible stays data-bound so expand/collapse still works. -->
                                    <Image Source="anim_countdown.gif"
                                           IsVisible="{Binding CountdownExpanded}"
                                           IsAnimationPlaying="True"
                                           HeightRequest="100"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: LIFE ODOMETER ==========================
                                 LIVE ticker - updated every second. Shows heartbeats + breaths.
                                 Binding: MainViewModel.LifeOdometer (TickerData)
                                 Commands: ToggleLifeOdometerCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x2764;&#xFE0F; -->
                                        <Label Grid.Column="0"
                                               Text="❤️"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="8"
                                                               VerticalOptions="Center">
                                            <!-- Binding: MainViewModel.Loc.Ticker_LifeOdometerTitle (live-localised) -->
                                            <Label Text="{Binding Loc.Ticker_LifeOdometerTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised) -->
                                            <Label x:Name="LiveBadgeLifeOdometer"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnLifeOdometerInfoClicked" />
                                            <!-- Expand/collapse: toggles LifeOdometerExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding LifeOdometerExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleLifeOdometerCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.LifeOdometer.BriefText - hidden when expanded, updates every second -->
                                    <Label Text="{Binding LifeOdometer.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding LifeOdometerExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.LifeOdometer.FullText - visible when expanded -->
                                    <Label Text="{Binding LifeOdometer.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding LifeOdometerExpanded}" />
                                    <!-- AI: Illustration image for the expanded LifeOdometer card.
                                         Source is a XAML literal ("heartbeat.png"), NOT a binding.
                                         Using a literal prevents the image from flickering every second
                                         when the LifeOdometer live-ticker rebuilds its result object,
                                         which would otherwise cause MAUI to reload the source on each tick.
                                         IsVisible is gated on LifeOdometerExpanded so the image only appears
                                         in the expanded view. -->
                                    <Image Source="heartbeat.png"
                                           IsVisible="{Binding LifeOdometerExpanded}"
                                           IsAnimationPlaying="True"
                                           HeightRequest="120"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: CELLULAR REFRESH =======================
                                 Static ticker - recalculated on base date change
                                 or via explicit RefreshCellularRefreshCommand.
                                 Binding: MainViewModel.CellularRefresh (CellularRefreshResult)
                                 Commands: RefreshCellularRefreshCommand, ToggleCellularRefreshCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">

                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: DNA emoji icon | Col1: title label | Col2: action buttons (info, refresh, expand)].
                                         Static ticker: no LIVE badge; refresh button recalculates via RefreshCellularRefreshCommand. -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F9EC; (DNA double helix) -->
                                        <Label Grid.Column="0"
                                               Text="🧬"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_CellularRefreshTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_CellularRefreshTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnCellularRefreshInfoClicked" />
                                            <!-- Refresh: shows RefreshingPopup then recalculates CellularRefresh -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="refresh.png"
                                                         Command="{Binding RefreshCellularRefreshCommand}" />
                                            <!-- Expand/collapse: toggles CellularRefreshExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding CellularRefreshExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleCellularRefreshCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Binding: MainViewModel.CellularRefresh.BriefText - hidden when expanded -->
                                    <Label Text="{Binding CellularRefresh.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding CellularRefreshExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.CellularRefresh.FullText - visible when expanded -->
                                    <Label Text="{Binding CellularRefresh.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding CellularRefreshExpanded}" />

                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- End Lab Section -->

                <!-- == COSMOS SECTION =========================================
                     Tickers: Alien Anniversaries, Galactic Commute (LIVE), Photon Path (LIVE),
                              Cosmic Stretch (LIVE), Vibrant Cosmos (LIVE 200ms)
                     Binding: MainViewModel.CosmosExpanded -> ToggleCosmosCommand
                ================================================================ -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Binding: MainViewModel.Loc.Section_CosmosTitle (live-localised) -->
                            <Label Grid.Column="0"
                                   Text="{Binding Loc.Section_CosmosTitle}"
                                   Style="{StaticResource SubtitleLabel}"
                                   TextColor="{DynamicResource CyberCyan}"
                                   VerticalOptions="Center" />
                            <!-- Binding: MainViewModel.CosmosExpanded -> chevron icon.
                                 Command: ToggleCosmosCommand -->
                            <ImageButton Grid.Column="1"
                                         Style="{StaticResource ThemedIconButton}"
                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                         Source="{Binding CosmosExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='chevron_up.png|chevron_down.png'}"
                                         Command="{Binding ToggleCosmosCommand}" />
                        </Grid>

                        <VerticalStackLayout Spacing="12"
                                             IsVisible="{Binding CosmosExpanded}">

                            <!-- == TICKER: ALIEN ANNIVERSARIES ====================
                                 Static ticker - recalculated on base date change or explicit refresh.
                                 Binding: MainViewModel.AlienAnniversaries (TickerData)
                                 Commands: RefreshAlienAnniversariesCommand, ToggleAlienAnniversariesCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F47D; -->
                                        <Label Grid.Column="0"
                                               Text="👽"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_AlienAnniversariesTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_AlienAnniversariesTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnAlienAnniversariesInfoClicked" />
                                            <!-- Refresh: shows RefreshingPopup then recalculates AlienAnniversaries -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="refresh.png"
                                                         Command="{Binding RefreshAlienAnniversariesCommand}" />
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding AlienAnniversariesExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleAlienAnniversariesCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.AlienAnniversaries.BriefText - hidden when expanded -->
                                    <Label Text="{Binding AlienAnniversaries.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding AlienAnniversariesExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.AlienAnniversaries.FullText -->
                                    <Label Text="{Binding AlienAnniversaries.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding AlienAnniversariesExpanded}" />
                                    <!-- AI: Orrery visualization - visible only when AlienAnniversariesExpanded=true.
                                         A 300x300 AbsoluteLayout: Sun (gold Ellipse), 5 orbit rings (grey strokes),
                                         a gold Today line at 12 o'clock, a Today label, 5 planet symbol Labels and
                                         5 planet name/years Labels. Planet positions are set imperatively via
                                         ApplyOrreryPositions in MainPage.xaml.cs because AbsoluteLayout.LayoutBounds
                                         cannot be data-bound. Orbit radii: Mercury=30, Venus=55, Earth=80, Mars=110,
                                         Jupiter=143. All colors use DynamicResource for ThemeService compatibility.
                                         Binding source: MainViewModel.AlienAnniversaries (AlienAnniversariesResult). -->
                                    <Grid IsVisible="{Binding AlienAnniversariesExpanded}"
                                          HorizontalOptions="Center"
                                          Margin="0,8,0,0">
                                        <AbsoluteLayout x:Name="OrreryCanvas"
                                                        WidthRequest="300"
                                                        HeightRequest="300"
                                                        HorizontalOptions="Center">
                                            <!-- Orbit: Mercury r=30 (X=120,Y=120,W=60,H=60) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="120, 120, 60, 60"
                                                     AbsoluteLayout.LayoutFlags="None"
                                                     Fill="Transparent"
                                                     Stroke="{DynamicResource TextGray}"
                                                     StrokeThickness="1"
                                                     Opacity="0.5" />
                                            <!-- Orbit: Venus r=55 (X=95,Y=95,W=110,H=110) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="95, 95, 110, 110"
                                                     AbsoluteLayout.LayoutFlags="None"
                                                     Fill="Transparent"
                                                     Stroke="{DynamicResource TextGray}"
                                                     StrokeThickness="1"
                                                     Opacity="0.5" />
                                            <!-- Orbit: Earth r=80 (X=70,Y=70,W=160,H=160) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="70, 70, 160, 160"
                                                     AbsoluteLayout.LayoutFlags="None"
                                                     Fill="Transparent"
                                                     Stroke="{DynamicResource TextGray}"
                                                     StrokeThickness="1"
                                                     Opacity="0.5" />
                                            <!-- Orbit: Mars r=110 (X=40,Y=40,W=220,H=220) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="40, 40, 220, 220"
                                                     AbsoluteLayout.LayoutFlags="None"
                                                     Fill="Transparent"
                                                     Stroke="{DynamicResource TextGray}"
                                                     StrokeThickness="1"
                                                     Opacity="0.5" />
                                            <!-- Orbit: Jupiter r=143 (X=7,Y=7,W=286,H=286) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="7, 7, 286, 286"
                                                     AbsoluteLayout.LayoutFlags="None"
                                                     Fill="Transparent"
                                                     Stroke="{DynamicResource TextGray}"
                                                     StrokeThickness="1"
                                                     Opacity="0.5" />
                                            <!-- Direction arrows: one per orbit at 6-o'clock (bottom tangent).
                                                 Clockwise orbital motion at 6-o'clock travels leftward, so the
                                                 arrow points left (U+25C4). Static positions - no code-behind needed. -->
                                            <!-- Mercury orbit arrow: r=30, bottom=(150,180) -->
                                            <Label AbsoluteLayout.LayoutBounds="141, 172, 14, 14"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x25C4;"
                                                   FontSize="9"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   Opacity="0.7" />
                                            <!-- Venus orbit arrow: r=55, bottom=(150,205) -->
                                            <Label AbsoluteLayout.LayoutBounds="141, 197, 14, 14"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x25C4;"
                                                   FontSize="9"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   Opacity="0.7" />
                                            <!-- Earth orbit arrow: r=80, bottom=(150,230) -->
                                            <Label AbsoluteLayout.LayoutBounds="141, 222, 14, 14"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x25C4;"
                                                   FontSize="9"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   Opacity="0.7" />
                                            <!-- Mars orbit arrow: r=110, bottom=(150,260) -->
                                            <Label AbsoluteLayout.LayoutBounds="141, 252, 14, 14"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x25C4;"
                                                   FontSize="9"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   Opacity="0.7" />
                                            <!-- Jupiter orbit arrow: r=143, bottom=(150,293) -->
                                            <Label AbsoluteLayout.LayoutBounds="141, 285, 14, 14"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x25C4;"
                                                   FontSize="9"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   Opacity="0.7" />
                                            <!-- Today line: center(150,150) to top(150,7), 2px gold -->
                                            <Line X1="150" Y1="150" X2="150" Y2="7"
                                                  AbsoluteLayout.LayoutBounds="0, 0, 300, 300"
                                                  AbsoluteLayout.LayoutFlags="None"
                                                  Stroke="{DynamicResource JubileeAccent}"
                                                  StrokeThickness="2" />
                                            <!-- Sun: gold filled circle r=10 at center (X=140,Y=140,W=20,H=20) -->
                                            <Ellipse AbsoluteLayout.LayoutBounds="140, 140, 20, 20"
                                                     AbsoluteLayout.LayoutFlags="None"
                                                     Fill="{DynamicResource JubileeAccent}" />
                                            <!-- Base date name label - left of the 12-o'clock line, right-aligned.
                                                 Text and position set imperatively by ApplyOrreryPositions. -->
                                            <Label x:Name="OrreryBaseDateNameLabel"
                                                   AbsoluteLayout.LayoutBounds="8, 0, 140, 18"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource JubileeAccent}"
                                                   HorizontalTextAlignment="End"
                                                   FontAttributes="Bold" />
                                            <!-- Base date value label - right of the 12-o'clock line, left-aligned.
                                                 Text and position set imperatively by ApplyOrreryPositions. -->
                                            <Label x:Name="OrreryBaseDateValueLabel"
                                                   AbsoluteLayout.LayoutBounds="152, 0, 140, 18"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   FontSize="12"
                                                   TextColor="{DynamicResource JubileeAccent}"
                                                   HorizontalTextAlignment="Start"
                                                   FontAttributes="Bold" />
                                            <!-- Mercury symbol U+263F - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryMercurySymbol"
                                                   AbsoluteLayout.LayoutBounds="141, 141, 18, 18"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x263F;"
                                                   FontSize="15"
                                                   TextColor="{DynamicResource TextWhite}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <!-- Venus symbol U+2640 - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryVenusSymbol"
                                                   AbsoluteLayout.LayoutBounds="141, 141, 18, 18"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x2640;"
                                                   FontSize="15"
                                                   TextColor="{DynamicResource TextWhite}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <!-- Earth symbol U+2641 - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryEarthSymbol"
                                                   AbsoluteLayout.LayoutBounds="141, 141, 18, 18"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x2641;"
                                                   FontSize="15"
                                                   TextColor="{DynamicResource TextWhite}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <!-- Mars symbol U+2642 - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryMarsSymbol"
                                                   AbsoluteLayout.LayoutBounds="141, 141, 18, 18"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x2642;"
                                                   FontSize="15"
                                                   TextColor="{DynamicResource TextWhite}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <!-- Jupiter symbol U+2643 - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryJupiterSymbol"
                                                   AbsoluteLayout.LayoutBounds="141, 141, 18, 18"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   Text="&#x2643;"
                                                   FontSize="15"
                                                   TextColor="{DynamicResource TextWhite}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center" />
                                            <!-- Mercury name/years label - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryMercuryLabel"
                                                   AbsoluteLayout.LayoutBounds="0, 0, 100, 20"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center" />
                                            <!-- Venus name/years label - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryVenusLabel"
                                                   AbsoluteLayout.LayoutBounds="0, 0, 100, 20"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center" />
                                            <!-- Earth name/years label - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryEarthLabel"
                                                   AbsoluteLayout.LayoutBounds="0, 0, 100, 20"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center" />
                                            <!-- Mars name/years label - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryMarsLabel"
                                                   AbsoluteLayout.LayoutBounds="0, 0, 100, 20"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center" />
                                            <!-- Jupiter name/years label - positioned by ApplyOrreryPositions -->
                                            <Label x:Name="OrreryJupiterLabel"
                                                   AbsoluteLayout.LayoutBounds="0, 0, 100, 20"
                                                   AbsoluteLayout.LayoutFlags="None"
                                                   FontSize="13"
                                                   TextColor="{DynamicResource TextGray}"
                                                   HorizontalTextAlignment="Center" />
                                        </AbsoluteLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: SPACE WAIT ========================================
                                 LIVE ticker - updated every second.
                                 Binding: MainViewModel.SpaceWait (SpaceWaitResult)
                                 Commands: ToggleSpaceWaitCommand
                                 No refresh button - live ticker.
                                 ============================================================= -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">

                                    <!-- AI: Ticker card header - 3-column layout:
                                         [Col0: planet emoji | Col1: title + LIVE badge | Col2: info + expand buttons].
                                         Bound to MainViewModel.SpaceWait (live-updated every second). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1FA90; (U+1FA90 ringed planet) -->
                                        <Label Grid.Column="0"
                                               Text="🪐"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- AI: Title + LIVE badge side-by-side in a HorizontalStackLayout
                                             so the badge sits flush to the right of the title text. -->
                                        <!-- Binding: MainViewModel.Loc.Ticker_SpaceWaitTitle (live-localised) -->
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="6"
                                                               VerticalOptions="Center">
                                            <Label Text="{Binding Loc.Ticker_SpaceWaitTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised) -->
                                            <Label x:Name="LiveBadgeSpaceWait"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnSpaceWaitInfoClicked" />
                                            <!-- Expand/collapse: toggles SpaceWaitExpanded -->
                                            <!-- Binding: MainViewModel.SpaceWaitExpanded -> BoolToImageSource -> icon -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding SpaceWaitExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleSpaceWaitCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Binding: MainViewModel.SpaceWait.BriefText - hidden when expanded, HTML-formatted -->
                                    <Label Text="{Binding SpaceWait.BriefText}"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           TextType="Html"
                                           IsVisible="{Binding SpaceWaitExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.SpaceWait.FullText - visible when expanded, HTML-formatted -->
                                    <Label Text="{Binding SpaceWait.FullText}"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           TextType="Html"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding SpaceWaitExpanded}" />
                                    <!-- AI: Split-flap illustration for the expanded SpaceWait card.
                                         Source is a XAML literal (not a binding) because SpaceWait is a
                                         live ticker rebuilt every second; a binding would restart MAUI's
                                         GIF decoder to frame 0 on each tick. Uses the Predator font variant
                                         (anim_spacewait.gif) to distinguish it visually from the Countdown
                                         card (anim_countdown.gif / Courier New font).
                                         IsVisible gated on SpaceWaitExpanded. -->
                                    <Image Source="anim_spacewait.gif"
                                           IsVisible="{Binding SpaceWaitExpanded}"
                                           IsAnimationPlaying="True"
                                           HeightRequest="100"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           Margin="0,8,0,0" />

                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: GALACTIC COMMUTE =======================
                                 LIVE ticker - updated every second. Distance varies with UseMetric.
                                 Binding: MainViewModel.GalacticCommute (TickerData)
                                 Commands: ToggleGalacticCommuteCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F680; -->
                                        <Label Grid.Column="0"
                                               Text="🚀"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="8"
                                                               VerticalOptions="Center">
                                            <!-- Binding: MainViewModel.Loc.Ticker_GalacticCommuteTitle (live-localised) -->
                                            <Label Text="{Binding Loc.Ticker_GalacticCommuteTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised) -->
                                            <Label x:Name="LiveBadgeGalacticCommute"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnGalacticCommuteInfoClicked" />
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding GalacticCommuteExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleGalacticCommuteCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.GalacticCommute.BriefText - hidden when expanded, updates every second -->
                                    <Label Text="{Binding GalacticCommute.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding GalacticCommuteExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.GalacticCommute.FullText -->
                                    <Label Text="{Binding GalacticCommute.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding GalacticCommuteExpanded}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: PHOTON PATH ============================
                                 LIVE ticker - updated every second. Narrative changes by light-year threshold.
                                 Binding: MainViewModel.PhotonPath (TickerData)
                                 Commands: TogglePhotonPathCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F4A1; -->
                                        <Label Grid.Column="0"
                                               Text="💡"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="8"
                                                               VerticalOptions="Center">
                                            <!-- Binding: MainViewModel.Loc.Ticker_PhotonPathTitle (live-localised) -->
                                            <Label Text="{Binding Loc.Ticker_PhotonPathTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised) -->
                                            <Label x:Name="LiveBadgePhotonPath"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnPhotonPathInfoClicked" />
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding PhotonPathExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding TogglePhotonPathCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.PhotonPath.BriefText - hidden when expanded, updates every second -->
                                    <Label Text="{Binding PhotonPath.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding PhotonPathExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.PhotonPath.FullText - visible when expanded -->
                                    <Label Text="{Binding PhotonPath.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding PhotonPathExpanded}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: COSMIC STRETCH =========================
                                 LIVE ticker - updated every second.
                                 Shows how much the observable universe has expanded since base date.
                                 Binding: MainViewModel.CosmicStretch (CosmicStretchResult)
                                 Command: ToggleCosmicStretchCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">

                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: emoji icon | Col1: title + LIVE badge | Col2: info + expand buttons].
                                         Binding: MainViewModel.CosmicStretch.BriefText / FullText (live-localised). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F30C; -->
                                        <Label Grid.Column="0"
                                               Text="🌌"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="8"
                                                               VerticalOptions="Center">
                                            <!-- Binding: MainViewModel.Loc.Ticker_CosmicStretchTitle (live-localised) -->
                                            <Label Text="{Binding Loc.Ticker_CosmicStretchTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised) -->
                                            <Label x:Name="LiveBadgeCosmicStretch"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with Hubble-Lemaitre methodology -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnCosmicStretchInfoClicked" />
                                            <!-- Expand/collapses: toggles CosmicStretchExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding CosmicStretchExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleCosmicStretchCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Binding: MainViewModel.CosmicStretch.BriefText - hidden when expanded, updates every second -->
                                    <Label Text="{Binding CosmicStretch.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding CosmicStretchExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.CosmicStretch.FullText - visible when expanded -->
                                    <Label Text="{Binding CosmicStretch.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding CosmicStretchExpanded}" />

                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: VIBRANT COSMOS =========================
                                 LIVE ticker - updated every 200 ms by a dedicated
                                 IDispatcherTimer in MainViewModel, producing a
                                 non-uniform rhythmic pulse effect.
                                 Shows cumulative star births and supernovas since base date.
                                 Binding: MainViewModel.VibrantCosmos (VibrantCosmosResult)
                                 Command: ToggleVibrantCosmosCommand
                                 Note: no refresh button - counts are purely elapsed-time driven.
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">

                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: sparkles emoji | Col1: title + LIVE badge | Col2: info + expand buttons].
                                         Binding: MainViewModel.VibrantCosmos.BriefText / FullText (live 200ms updates). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x2728; (U+2728 sparkles) -->
                                        <Label Grid.Column="0"
                                               Text="✨"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- AI: Title + LIVE badge side-by-side in a HorizontalStackLayout. -->
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="8"
                                                               VerticalOptions="Center">
                                            <!-- Binding: MainViewModel.Loc.Ticker_VibrantCosmosTitle (live-localised) -->
                                            <Label Text="{Binding Loc.Ticker_VibrantCosmosTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised badge label) -->
                                            <Label x:Name="LiveBadgeVibrantCosmos"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnVibrantCosmosInfoClicked" />
                                            <!-- Expand/collapse: toggles VibrantCosmosExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding VibrantCosmosExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleVibrantCosmosCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Binding: MainViewModel.VibrantCosmos.BriefText - hidden when expanded, updates every 200 ms -->
                                    <Label Text="{Binding VibrantCosmos.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding VibrantCosmosExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.VibrantCosmos.FullText - visible when expanded -->
                                    <Label Text="{Binding VibrantCosmos.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding VibrantCosmosExpanded}" />

                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- End Cosmos Section -->

                <!-- == MIRROR SECTION =========================================
                     Tickers: Human Birth Rank (static), Birth Rune (static),
                              Personal Year (static), Global Crowd (LIVE)
                     Binding: MainViewModel.MirrorExpanded -> ToggleMirrorCommand
                ================================================================ -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Binding: MainViewModel.Loc.Section_MirrorTitle (live-localised) -->
                            <Label Grid.Column="0"
                                   Text="{Binding Loc.Section_MirrorTitle}"
                                   Style="{StaticResource SubtitleLabel}"
                                   TextColor="{DynamicResource CyberCyan}"
                                   VerticalOptions="Center" />
                            <ImageButton Grid.Column="1"
                                         Style="{StaticResource ThemedIconButton}"
                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                         Source="{Binding MirrorExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='chevron_up.png|chevron_down.png'}"
                                         Command="{Binding ToggleMirrorCommand}" />
                        </Grid>

                        <VerticalStackLayout Spacing="12"
                                             IsVisible="{Binding MirrorExpanded}">

                            <!-- == TICKER: HUMAN BIRTH RANK =======================
                                 Binding: MainViewModel.HumanBirthRank (TickerData)
                                 Commands: ToggleHumanBirthRankCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F3C5; -->
                                        <Label Grid.Column="0"
                                               Text="🏅"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_HumanBirthRankTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_HumanBirthRankTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnHumanBirthRankInfoClicked" />
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding HumanBirthRankExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleHumanBirthRankCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.HumanBirthRank.BriefText - hidden when expanded -->
                                    <Label Text="{Binding HumanBirthRank.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding HumanBirthRankExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.HumanBirthRank.FullText -->
                                    <Label Text="{Binding HumanBirthRank.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding HumanBirthRankExpanded}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: BIRTH RUNE =============================
                                 Binding: MainViewModel.BirthRune (TickerData)
                                 Commands: ToggleBirthRuneCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F52E; -->
                                        <Label Grid.Column="0"
                                               Text="🔮"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_BirthRuneTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_BirthRuneTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnBirthRuneInfoClicked" />
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding BirthRuneExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleBirthRuneCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.BirthRune.BriefText - hidden when expanded -->
                                    <Label Text="{Binding BirthRune.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding BirthRuneExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.BirthRune.FullText -->
                                    <Label Text="{Binding BirthRune.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding BirthRuneExpanded}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: PERSONAL YEAR ==========================
                                 Binding: MainViewModel.PersonalYear (TickerData)
                                 Commands: TogglePersonalYearCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F5D3;&#xFE0F; -->
                                        <Label Grid.Column="0"
                                               Text="🗓️"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_PersonalYearTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_PersonalYearTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnPersonalYearInfoClicked" />
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding PersonalYearExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding TogglePersonalYearCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.PersonalYear.BriefText - hidden when expanded -->
                                    <Label Text="{Binding PersonalYear.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding PersonalYearExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.PersonalYear.FullText -->
                                    <Label Text="{Binding PersonalYear.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding PersonalYearExpanded}" />
                                </VerticalStackLayout>
                            </Border>


                            <!-- == TICKER: GLOBAL CROWD ===========================
                                 Live ticker (every second) - no refresh button.
                                 Binding: MainViewModel.GlobalCrowd (GlobalCrowdResult)
                                 Commands: ToggleGlobalCrowdCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: people emoji | Col1: title + LIVE badge | Col2: info + expand buttons]
                                         Bound to MainViewModel.GlobalCrowd (live-updated every second). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F465; (busts in silhouette - U+1F465) -->
                                        <Label Grid.Column="0"
                                               Text="👥"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- AI: Title + LIVE badge side-by-side in a HorizontalStackLayout
                                             so the badge sits flush to the right of the title text. -->
                                        <!-- Binding: MainViewModel.Loc.Ticker_GlobalCrowdTitle (live-localised) -->
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="6"
                                                               VerticalOptions="Center">
                                            <Label Text="{Binding Loc.Ticker_GlobalCrowdTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised) -->
                                            <Label x:Name="LiveBadgeGlobalCrowd"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnGlobalCrowdInfoClicked" />
                                            <!-- Expand/collapse: toggles GlobalCrowdExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding GlobalCrowdExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleGlobalCrowdCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.GlobalCrowd.BriefText - hidden when expanded, updates every second -->
                                    <Label Text="{Binding GlobalCrowd.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding GlobalCrowdExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.GlobalCrowd.FullText - visible when expanded -->
                                    <Label Text="{Binding GlobalCrowd.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding GlobalCrowdExpanded}" />
                                </VerticalStackLayout>
                            </Border>

                                <!-- == TICKER: LIFE LOG ================================
                                 Static ticker with refresh button - recalculated on
                                 base date change or via explicit RefreshLifeLogCommand.
                                 Brief view randomly picks 2 activities; refresh re-randomises.
                                 Binding: MainViewModel.LifeLog (LifeLogResult)
                                 Commands: RefreshLifeLogCommand, ToggleLifeLogCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: clock emoji | Col1: title | Col2: info + refresh + expand buttons]
                                         Bound to MainViewModel.LifeLog (static, re-randomises on refresh). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F570; (U+1F570 Mantelpiece Clock) -->
                                        <Label Grid.Column="0"
                                               Text="🕰️"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_LifeLogTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_LifeLogTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology and sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnLifeLogInfoClicked" />
                                            <!-- Refresh: re-randomises the two brief-view activities -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="refresh.png"
                                                         Command="{Binding RefreshLifeLogCommand}" />
                                            <!-- Expand/collapse: toggles LifeLogExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding LifeLogExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleLifeLogCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.LifeLog.BriefText - hidden when expanded; HTML formatted -->
                                    <Label Text="{Binding LifeLog.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding LifeLogExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.LifeLog.FullText - visible when expanded; HTML formatted -->
                                    <Label Text="{Binding LifeLog.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding LifeLogExpanded}" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- == TICKER: VIBRANT HUMANITY =========================
                                 LIVE ticker - recalculated every second by the timer.
                                 Binding: MainViewModel.VibrantHumanity (VibrantHumanityResult)
                                 Command: ToggleVibrantHumanityCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: globe emoji | Col1: title + LIVE badge | Col2: info + expand buttons]
                                         Bound to MainViewModel.VibrantHumanity (live-updated every second). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: globe (U+1F30E) -->
                                        <Label Grid.Column="0"
                                               Text="🌍"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- AI: Title + LIVE badge side-by-side in a HorizontalStackLayout. -->
                                        <!-- Binding: MainViewModel.Loc.Ticker_VibrantHumanityTitle (live-localised) -->
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="6"
                                                               VerticalOptions="Center">
                                            <Label Text="{Binding Loc.Ticker_VibrantHumanityTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE -->
                                            <Label x:Name="LiveBadgeVibrantHumanity"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnVibrantHumanityInfoClicked" />
                                            <!-- Expand/collapse: toggles VibrantHumanityExpanded -->
                                            <!-- Binding: MainViewModel.VibrantHumanityExpanded -> BoolToImageSource -> icon -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding VibrantHumanityExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleVibrantHumanityCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.VibrantHumanity.BriefText - hidden when expanded, HTML formatted -->
                                    <Label Text="{Binding VibrantHumanity.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding VibrantHumanityExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.VibrantHumanity.FullText - visible when expanded, HTML formatted -->
                                    <Label Text="{Binding VibrantHumanity.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding VibrantHumanityExpanded}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- End Mirror Section -->

                <!-- == ECO ECHOES SECTION =====================================
                     Tickers: Global Exhale (static with explicit refresh), Your Breath (LIVE)
                     Binding: MainViewModel.EcoExpanded -> ToggleEcoCommand
                ================================================================ -->
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Binding: MainViewModel.Loc.Section_EcoEchoesTitle (live-localised) -->
                            <Label Grid.Column="0"
                                   Text="{Binding Loc.Section_EcoEchoesTitle}"
                                   Style="{StaticResource SubtitleLabel}"
                                   TextColor="{DynamicResource CyberCyan}"
                                   VerticalOptions="Center" />
                            <ImageButton Grid.Column="1"
                                         Style="{StaticResource ThemedIconButton}"
                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                         Source="{Binding EcoExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='chevron_up.png|chevron_down.png'}"
                                         Command="{Binding ToggleEcoCommand}" />
                        </Grid>

                        <VerticalStackLayout Spacing="12"
                                             IsVisible="{Binding EcoExpanded}">

                            <!-- == TICKER: GLOBAL EXHALE ==========================
                                 Static ticker with explicit refresh support.
                                 Binding: MainViewModel.GlobalExhale (TickerData)
                                 Commands: RefreshGlobalExhaleCommand, ToggleGlobalExhaleCommand
                                 Note: UseMetric affects output units (BTonnes vs BTons).
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F33F; -->
                                        <Label Grid.Column="0"
                                               Text="🌿"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_GlobalExhaleTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_GlobalExhaleTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnGlobalExhaleInfoClicked" />
                                            <!-- Refresh: shows RefreshingPopup then recalculates GlobalExhale -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="refresh.png"
                                                         Command="{Binding RefreshGlobalExhaleCommand}" />
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding GlobalExhaleExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleGlobalExhaleCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <!-- Binding: MainViewModel.GlobalExhale.BriefText - hidden when expanded -->
                                    <Label Text="{Binding GlobalExhale.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding GlobalExhaleExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.GlobalExhale.FullText -->
                                    <Label Text="{Binding GlobalExhale.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding GlobalExhaleExpanded}" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: YOUR BREATH ============================
                                 LIVE ticker - updated every second by MainViewModel timer.
                                 Binding: MainViewModel.YourBreath (YourBreathResult)
                                 Commands: ToggleYourBreathCommand
                                 Note: air volume is always litres; CO2 mass follows UseMetric.
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">

                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: lung emoji icon | Col1: title + LIVE badge | Col2: action buttons (info, expand)] -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1FAC1; (lungs) -->
                                        <Label Grid.Column="0"
                                               Text="🫁"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- AI: Title + LIVE badge side-by-side in a HorizontalStackLayout.
                                             Badge Labels carry x:Name="LiveBadgeXxx" so MainPage.xaml.cs can
                                             drive a continuous InOutSine breathing animation via Animation.Commit. -->
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="8"
                                                               VerticalOptions="Center">
                                            <!-- Binding: MainViewModel.Loc.Ticker_YourBreathTitle (live-localised) -->
                                            <Label Text="{Binding Loc.Ticker_YourBreathTitle}"
                                                   Style="{StaticResource BaseLabel}"
                                                   TextColor="{DynamicResource CyberPurple}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />
                                            <!-- Binding: MainViewModel.Loc.Badge_LIVE (live-localised badge label) -->
                                            <Label x:Name="LiveBadgeYourBreath"
                                                   Text="{Binding Loc.Badge_LIVE}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   TextColor="{DynamicResource NeonGreen}"
                                                   BackgroundColor="{DynamicResource NeonGreenDark}"
                                                   Padding="4,2"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnYourBreathInfoClicked" />
                                            <!-- Expand/collapse: toggles YourBreathExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding YourBreathExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleYourBreathCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Binding: MainViewModel.YourBreath.BriefText - hidden when expanded -->
                                    <Label Text="{Binding YourBreath.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding YourBreathExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.YourBreath.FullText - visible when expanded -->
                                    <Label Text="{Binding YourBreath.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding YourBreathExpanded}" />

                                </VerticalStackLayout>
                            </Border>

                            <!-- == TICKER: VIBRANT NATURE ========================
                                 Static ticker - recalculated on base date change
                                 or via explicit RefreshVibrantNatureCommand.
                                 Binding: MainViewModel.VibrantNature (VibrantNatureResult)
                                 Commands: RefreshVibrantNatureCommand, ToggleVibrantNatureCommand
                            ======================================================== -->
                            <Border BackgroundColor="{DynamicResource CardDark}"
                                    StrokeThickness="1"
                                    Stroke="{DynamicResource CyberCyan}"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12">
                                <VerticalStackLayout Spacing="8">

                                    <!-- AI: Ticker card header - 3-column:
                                         [Col0: butterfly emoji icon | Col1: title | Col2: action buttons (info, refresh, expand)] -->
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Emoji: &#x1F98B; (butterfly) -->
                                        <Label Grid.Column="0"
                                               Text="🦋"
                                               FontSize="{DynamicResource FontSizeTitle}"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />
                                        <!-- Binding: MainViewModel.Loc.Ticker_VibrantNatureTitle (live-localised) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Loc.Ticker_VibrantNatureTitle}"
                                               Style="{StaticResource BaseLabel}"
                                               TextColor="{DynamicResource CyberPurple}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <!-- Info: opens DeepDivePopup with methodology + sources -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="info.png"
                                                         Clicked="OnVibrantNatureInfoClicked" />
                                            <!-- Refresh: shows RefreshingPopup then recalculates VibrantNature -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="refresh.png"
                                                         Command="{Binding RefreshVibrantNatureCommand}" />
                                            <!-- Expand/collapse: toggles VibrantNatureExpanded -->
                                            <ImageButton Style="{StaticResource ThemedIconButton}"
                                                         helpers:ImageTint.Color="{DynamicResource CyberCyan}"
                                                         Source="{Binding VibrantNatureExpanded, Converter={StaticResource BoolToImageSource}, ConverterParameter='square_chevron_up.png|square_chevron_down.png'}"
                                                         Command="{Binding ToggleVibrantNatureCommand}" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!-- Binding: MainViewModel.VibrantNature.BriefText - hidden when expanded -->
                                    <Label Text="{Binding VibrantNature.BriefText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           IsVisible="{Binding VibrantNatureExpanded, Converter={StaticResource InverseBool}}" />
                                    <!-- Binding: MainViewModel.VibrantNature.FullText - visible when expanded -->
                                    <Label Text="{Binding VibrantNature.FullText}"
                                           TextType="Html"
                                           TextColor="{DynamicResource TextGray}"
                                           FontSize="{DynamicResource FontSizeMedium}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding VibrantNatureExpanded}" />

                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <!-- End Eco Echoes Section -->

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>