<?xml version="1.0" encoding="utf-8" ?>
<!-- AI: Modal popup for editing the user's base date (name + date).
     Pushed onto the navigation stack from MainPage (via TimelineHeading tap
     or via MainMenuPopup -> OnChangeDateClicked).
     BindingContext is NOT set here - this popup uses x:Static AppResources
     for labels and code-behind for data initialisation (see ChangeDatePopup.xaml.cs). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:Aeonpulse.Resources"
             x:Class="Aeonpulse.Views.ChangeDatePopup"
             x:Name="ChangeDatePopupPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <!-- AI: Centred single-card layout - no overlay dismiss (intentional:
             user must explicitly confirm or cancel to avoid accidental dismissal
             of an in-progress edit). -->
        <Grid x:Name="ChangeDateRoot"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              Margin="24,0">

            <!-- Modal panel - styled with CardBackground + CyberPurple border -->
            <Frame x:Name="ChangeDatePanel"
                   BackgroundColor="{DynamicResource CardBackground}"
                   CornerRadius="16"
                   Padding="24"
                   HasShadow="True"
                   BorderColor="{DynamicResource CyberPurple}">

                <VerticalStackLayout Spacing="16">

                    <!-- Title: static resource (does not need live language updates
                         because the popup is always reopened after a language change) -->
                    <Label x:Name="ChangeDateTitleLabel"
                           Text="{x:Static resources:AppResources.ChangeDate_Title}"
                           FontSize="{DynamicResource FontSizeTitle}"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{DynamicResource CyberCyan}" />

                    <!-- Instruction text -->
                    <Label x:Name="ChangeDateDescriptionLabel"
                           Text="{x:Static resources:AppResources.ChangeDate_Description}"
                           FontSize="{DynamicResource FontSizeMedium}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{DynamicResource TextGray}" />

                    <BoxView x:Name="ChangeDateDivider1"
                             HeightRequest="1"
                             Color="{DynamicResource CyberPurple}"
                             Opacity="0.4"
                             HorizontalOptions="Fill" />

                    <!-- AI: Event Name field - pre-populated with MainViewModel.BaseDateName
                         in code-behind constructor. ReturnType=Next moves focus to the DatePicker. -->
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="EventNameLabel"
                               Text="{x:Static resources:AppResources.ChangeDate_BaseDateNameLabel}"
                               FontSize="{DynamicResource FontSizeMedium}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource CyberPurple}" />
                        <Frame x:Name="EventNameFrame"
                               Padding="10,8"
                               CornerRadius="8"
                               BorderColor="{DynamicResource CyberPurple}"
                               BackgroundColor="{DynamicResource SpaceDark}"
                               HasShadow="False">
                            <!-- x:Name required: code-behind reads EventNameEntry.Text on OK -->
                            <Entry x:Name="EventNameEntry"
                                   Placeholder="{x:Static resources:AppResources.ChangeDate_BaseDateNamePlaceholder}"
                                   PlaceholderColor="{DynamicResource TextGray}"
                                   TextColor="{DynamicResource TextWhite}"
                                   BackgroundColor="Transparent"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   ReturnType="Next" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- AI: Date field - pre-populated with MainViewModel.BaseDateValue
                         in code-behind constructor. Reads EventDatePicker.Date on OK. -->
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="EventDateLabel"
                               Text="{x:Static resources:AppResources.ChangeDate_BaseDateLabel}"
                               FontSize="{DynamicResource FontSizeMedium}"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource CyberPurple}" />
                        <Frame x:Name="EventDateFrame"
                               Padding="10,4"
                               CornerRadius="8"
                               BorderColor="{DynamicResource CyberPurple}"
                               BackgroundColor="{DynamicResource SpaceDark}"
                               HasShadow="False">
                            <!-- x:Name required: code-behind reads EventDatePicker.Date on OK -->
                            <DatePicker x:Name="EventDatePicker"
                                        TextColor="{DynamicResource TextWhite}"
                                        BackgroundColor="Transparent"
                                        FontSize="{DynamicResource FontSizeLarge}"
                                        HorizontalOptions="Fill" />
                        </Frame>
                    </VerticalStackLayout>

                    <BoxView x:Name="ChangeDateDivider2"
                             HeightRequest="1"
                             Color="{DynamicResource CyberPurple}"
                             Opacity="0.4"
                             HorizontalOptions="Fill" />

                    <!-- AI: 2-button footer - Cancel (left) | OK (right).
                         OK calls MainViewModel.SaveDate() which atomically updates
                         BaseDateName, BaseDateValue, and BaseDate before recalculating. -->
                    <Grid x:Name="ChangeDateButtonRow"
                          ColumnDefinitions="*,12,*"
                          HorizontalOptions="Fill">

                        <!-- Cancel - does not save; pops the modal -->
                        <Button Grid.Column="0"
                                x:Name="CloseButton"
                                Text="{x:Static resources:AppResources.ChangeDate_ButtonClose}"
                                Clicked="OnCloseClicked"
                                BackgroundColor="{DynamicResource SpaceDark}"
                                TextColor="{DynamicResource TextGray}"
                                CornerRadius="8"
                                FontSize="{StaticResource FontSizeLarge}"
                                HeightRequest="44"
                                BorderColor="{DynamicResource CyberPurple}"
                                BorderWidth="1" />

                        <!-- OK - validates, calls SaveDate(), pops the modal -->
                        <Button Grid.Column="2"
                                x:Name="OkButton"
                                Text="{x:Static resources:AppResources.ChangeDate_ButtonOK}"
                                Clicked="OnOkClicked"
                                BackgroundColor="{DynamicResource CyberPurple}"
                                TextColor="{DynamicResource SpaceDarker}"
                                CornerRadius="8"
                                FontSize="{StaticResource FontSizeLarge}"
                                FontAttributes="Bold"
                                HeightRequest="44" />

                    </Grid>

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ContentPage.Content>
</ContentPage>