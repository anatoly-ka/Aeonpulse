<?xml version="1.0" encoding="utf-8" ?>
<!-- AI: Reusable "Deep Dive" info popup - shows methodology and data attribution
     for any ticker card. All content is injected via the constructor in code-behind
     (DeepDivePopup.xaml.cs); this XAML defines the shell only.
     Pushed modally from MainPage.OpenDeepDiveAsync() with a topOffset
     that aligns the panel top edge flush with the bottom of the Timeline Heading. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:Aeonpulse.Resources"
             x:Class="Aeonpulse.Views.DeepDivePopup"
             x:Name="DeepDivePopupPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False">

    <ContentPage.Content>
        <!-- AI: Full-screen overlay grid.
             Layer 0: transparent BoxView captures taps outside the panel -> dismiss.
             Layer 1: the panel Frame, positioned by code-behind via Margin injection. -->
        <Grid x:Name="PopupContainer"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <!-- Tap-to-dismiss backdrop -->
            <BoxView x:Name="DismissBackdrop"
                     Color="Transparent"
                     InputTransparent="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <!-- AI: Panel frame - top Margin is overridden in code-behind to align
                 with the Timeline Heading bottom edge (NavBar.Height + TimelineHeading.Height).
                 Left/Right/Bottom margins stay as defined here. -->
            <Frame x:Name="PopupFrame"
                   BackgroundColor="{DynamicResource CardBackground}"
                   CornerRadius="16"
                   Padding="0"
                   HasShadow="True"
                   BorderColor="{DynamicResource CyberPurple}"
                   Margin="24,0,24,24"
                   VerticalOptions="Fill">

                <!-- AI: 3-row panel: [Title+Divider | ScrollableContent | Footer+CloseButton] -->
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Row 0: Non-scrollable heading - title set in code-behind -->
                    <VerticalStackLayout Grid.Row="0"
                                         x:Name="DeepDiveTitleBar"
                                         Spacing="0"
                                         Padding="24,20,24,0">
                        <!-- x:Name required: code-behind sets TitleLabel.Text from constructor arg -->
                        <Label x:Name="TitleLabel"
                               FontSize="{DynamicResource FontSizeTitle}"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{DynamicResource CyberCyan}" />

                        <BoxView x:Name="TitleDivider"
                                 HeightRequest="1"
                                 Color="{DynamicResource CyberPurple}"
                                 Opacity="0.4"
                                 HorizontalOptions="Fill"
                                 Margin="0,16,0,0" />
                    </VerticalStackLayout>

                    <!-- Row 1: Scrollable content - two labelled sections injected by code-behind -->
                    <ScrollView Grid.Row="1"
                                x:Name="DeepDiveScrollView"
                                Padding="24,16">
                        <VerticalStackLayout Spacing="16">

                            <!-- Section 1: The Methodology (title + body text) -->
                            <VerticalStackLayout x:Name="Section1Container" Spacing="8">
                                <!-- x:Name required: text set from constructor arg section1Title -->
                                <Label x:Name="Section1TitleLabel"
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource CyberPurple}" />
                                <!-- x:Name required: text set from constructor arg section1Text -->
                                <Label x:Name="Section1TextLabel"
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource TextGray}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <BoxView x:Name="ContentDivider"
                                     HeightRequest="1"
                                     Color="{DynamicResource CyberPurple}"
                                     Opacity="0.4"
                                     HorizontalOptions="Fill" />

                            <!-- Section 2: Data Sources & Attribution (title + body text) -->
                            <VerticalStackLayout x:Name="Section2Container" Spacing="8">
                                <!-- x:Name required: text set from constructor arg section2Title -->
                                <Label x:Name="Section2TitleLabel"
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource CyberPurple}" />
                                <!-- x:Name required: text set from constructor arg section2Text -->
                                <Label x:Name="Section2TextLabel"
                                       FontSize="{DynamicResource FontSizeMedium}"
                                       TextColor="{DynamicResource TextGray}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Row 2: Non-scrollable footer with Close button -->
                    <VerticalStackLayout Grid.Row="2"
                                         x:Name="DeepDiveFooter"
                                         Padding="24,0,24,20"
                                         Spacing="0">
                        <BoxView x:Name="FooterDivider"
                                 HeightRequest="1"
                                 Color="{DynamicResource CyberPurple}"
                                 Opacity="0.4"
                                 HorizontalOptions="Fill"
                                 Margin="0,0,0,16" />
                        <!-- Binding: x:Static AppResources.Info_ButtonClose (static, not live-localised) -->
                        <Button x:Name="CloseButton"
                                Text="{x:Static resources:AppResources.Info_ButtonClose}"
                                Clicked="OnCloseClicked"
                                HorizontalOptions="Center"
                                WidthRequest="160"
                                BackgroundColor="{DynamicResource SpaceDark}"
                                TextColor="{DynamicResource TextGray}"
                                CornerRadius="8"
                                FontSize="{DynamicResource FontSizeLarge}"
                                HeightRequest="44"
                                BorderColor="{DynamicResource CyberPurple}"
                                BorderWidth="1" />
                    </VerticalStackLayout>

                </Grid>
            </Frame>
        </Grid>
    </ContentPage.Content>
</ContentPage>